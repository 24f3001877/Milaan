# --- Application -------------------------------------------------------
APP_ENV=development                 # development | ci | demo  (staging/production not implemented)
API_TOKEN=change-me-dev-token       # single static bearer token, required on all /api/* routes

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://milaan:milaan@postgres:5432/milaan
DATABASE_URL_SYNC=postgresql+psycopg://milaan:milaan@postgres:5432/milaan   # used by Alembic

# --- Redis / Celery --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- LLM -------------------------------------------------------------------
LLM_MODE=cached                     # live | cached | disabled — cached needs no key, no network
LLM_PROVIDER=gemini                 # gemini | groq | anthropic | openai
LLM_API_KEY=                        # optional; only required when LLM_MODE=live
LLM_MODEL=gemini-2.5-flash
LLM_PROMPT_VERSION=v1

# --- Dev-only ----------------------------------------------------------
# /dev/seed route is gated at route-registration time; cannot be enabled outside APP_ENV=development
DEV_SEED_ENABLED=true

# --- Observability -----------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | console (console is nicer for local dev)

# --- Deployment --------------------------------------------------------
# Browser origins allowed to call the API, comma-separated. Only needed when the SPA is
# served from a different origin than the API. Leave as-is for local dev; leave as-is for
# the single-image deployment too, where the API serves the SPA itself and no cross-origin
# request is ever made.
CORS_ORIGINS=http://localhost:5173

# Directory holding the built SPA. When it exists, the API serves the frontend at `/`.
# Local dev leaves this alone — `frontend/dist` is absent and Vite serves the SPA instead.
# Dockerfile.deploy sets it to /app/frontend/dist.
STATIC_DIR=frontend/dist
