# syntax=docker/dockerfile:1
#
# Single-image deployment build. `Dockerfile` stays the development image that
# docker-compose.yml builds; this one exists because a deployed Milaan has to be *one*
# service, for a reason that is structural rather than aesthetic:
#
#   - The API writes uploaded files to `data/uploads/<uuid>` and the Celery worker reads
#     them back from the same path (app/api/runs.py, app/tasks/run_task.py). On a PaaS,
#     separate services get separate filesystems, so a run submitted to the API would fail
#     in the worker with "uploaded file not found".
#   - Serving the SPA from the API process makes the deployment same-origin, which removes
#     CORS from the picture entirely and means one URL to submit.
#
# Build:  docker build -f Dockerfile.deploy --build-arg VITE_API_TOKEN=<token> -t milaan .
# Run:    docker run -p 8000:8000 --env-file .env.deploy milaan

# ── Frontend ─────────────────────────────────────────────────────────────────────────────
FROM node:22-slim AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# Vite inlines VITE_* at build time, so the API token has to be present now and not at
# runtime. It is baked into the bundle either way: this app authenticates with one static
# bearer token and has no login, so anyone who can load the page can call the API. That is
# a property of the existing design, not of this Dockerfile — but it is the reason the
# deployed token should be a demo token and not one that guards anything real.
ARG VITE_API_TOKEN=change-me-dev-token
ARG VITE_API_BASE_URL=""
ENV VITE_API_TOKEN=$VITE_API_TOKEN
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# ── Python dependencies ──────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS builder
RUN pip install --no-cache-dir uv
WORKDIR /app
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev || uv sync --no-dev
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./

# ── Runtime ──────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim
RUN useradd --create-home --shell /bin/bash milaan
WORKDIR /app

COPY --chown=milaan:milaan --from=builder /app /app
COPY --chown=milaan:milaan --from=frontend /build/dist /app/frontend/dist
# The synthetic generator's output: three CSVs a reviewer can download and upload back
# through the mapping screen, so the deployment is demonstrable without a local checkout.
COPY --chown=milaan:milaan data/synthetic /app/data/synthetic
COPY --chown=milaan:milaan scripts/deploy-entrypoint.sh /app/scripts/deploy-entrypoint.sh

RUN chmod +x /app/scripts/deploy-entrypoint.sh \
 && mkdir -p /app/data/uploads /app/data/llm_cache \
 && chown -R milaan:milaan /app

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
ENV PYTHONUNBUFFERED=1
ENV STATIC_DIR="/app/frontend/dist"

USER milaan
EXPOSE 8000
CMD ["/app/scripts/deploy-entrypoint.sh"]
