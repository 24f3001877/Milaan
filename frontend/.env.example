# Where the browser sends /api/v1/... requests.
#
# Local dev: leave this EMPTY. Requests go to the Vite dev server's own origin and
# vite.config.ts proxies /api through to the API, so no CORS preflight is involved and
# the dev server works on any port.
#
# Deployment: set this to the API origin, e.g. https://milaan-api.fly.dev — and add that
# frontend origin to allow_origins in src/milaan/app/main.py. If the API is reverse-proxied
# under the same origin as the SPA (recommended), leave it empty here too.
VITE_API_BASE_URL=

# Must match API_TOKEN in the repo-root .env.
VITE_API_TOKEN=change-me-dev-token

# Optional: override the proxy target if the API is not on localhost:8000 in dev.
# VITE_DEV_API_PROXY_TARGET=http://localhost:8000
